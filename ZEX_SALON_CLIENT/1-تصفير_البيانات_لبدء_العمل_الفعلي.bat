@echo off
chcp 65001 >nul
title ZEX SALON - أداة تصفير العمليات وبدء العمل الفعلي
cls
echo =====================================================================
echo              ZEX SALON POS - أداة تصفير العمليات التجريبية
echo =====================================================================
echo.
echo  تنبيه: سيتم إغلاق البرنامج أولاً لضمان سلامة قاعدة البيانات.
echo.
taskkill /f /im SalonPOS.exe >nul 2>&1
timeout /t 1 >nul

echo  [1/3] جاري حفظ نسخة احتياطية من بيانات التدريب...
if not exist "%~dp0Backups" mkdir "%~dp0Backups"
copy /y "%~dp0salon_pos.db" "%~dp0Backups\training_before_reset.db" >nul

echo  [2/3] جاري تصفير الفواتير والمبيعات والورديات والمصروفات...
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0reset_db.ps1"

echo  [3/3] التحقق والانتهاء...
echo.
echo =====================================================================
echo  تهانينا! تم تصفير قاعدة البيانات بنجاح:
echo   - تم تصفير الفواتير لتبدأ الفاتورة القادمة من رقم 1.
echo   - تم تصفير الورديات والمصروفات وحركات الكراسي والعملاء التجريبيين.
echo   - تم الاحتفاظ بالترخيص، وبيانات الصالون، وقائمة الخدمات، والأسعار.
echo =====================================================================
echo.
pause
